# Reference list of the environment variables the backend needs.
# Spring Boot does NOT read this file: set these in your IntelliJ run configuration (or your system environment).
DB_PASSWORD=your-mysql-password
# DB_USERNAME=root
JWT_SECRET=replace-with-random-text-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-password-8-or-more-chars
